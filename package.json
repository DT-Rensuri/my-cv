{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "dev:web": "pnpm -rF @proj-airi/stage-web run dev",
        "dev:backend": "docker compose -f server/docker-compose.yaml up --build",
